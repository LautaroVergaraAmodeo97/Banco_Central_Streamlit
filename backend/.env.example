# Copiá este archivo como backend/.env y completá los valores.
# backend/.env está en .gitignore: NUNCA lo subas al repositorio.
# En producción, cargá estas variables en el panel del hosting.

# desarrollo | produccion (en produccion se ocultan /docs y /openapi.json)
ENTORNO=desarrollo

# Orígenes del frontend permitidos por CORS, separados por coma
FRONTEND_ORIGINS=http://localhost:3000

# IPs de proxies cuya cabecera X-Forwarded-For es confiable (por ejemplo, el servidor de Next.js)
PROXIES_CONFIABLES=127.0.0.1,::1

# Correo del formulario de contacto.
# Usá una "contraseña de aplicación" de Google (https://myaccount.google.com/apppasswords),
# nunca la contraseña real de la cuenta.
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=
MAIL_FROM=tu-cuenta@gmail.com
MAIL_TO=tu-cuenta@gmail.com

# Token JWT del Catálogo API-INDEC. Se genera en el perfil de https://api.indec.gob.ar
# (registro con email + código OTP). Se muestra una sola vez: guardalo solo acá.
INDEC_TOKEN=
