# Copiá este archivo como .env.local (está en .gitignore).
# Acá solo van valores públicos: todo lo que empieza con NEXT_PUBLIC_ llega al navegador.

# URL del backend FastAPI que usa el servidor de Next.js para reenviar /api/*
BACKEND_URL=http://localhost:8000

# Opcional: si se define, el navegador llama directo a esta URL en vez de pasar por /api
# NEXT_PUBLIC_API_URL=http://localhost:8000
